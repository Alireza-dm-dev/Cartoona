# ──────────────────────────────────────────────────────────────────────────────
# Cartoona — Docker runtime environment (TEMPLATE, V0.1.35)
#
#   cp .env.docker.example .env.docker     then fill in real values locally.
#
# PLACEHOLDERS ONLY in this file. `.env.docker` is gitignored and must never be
# committed, and nothing from it is ever copied into the image — compose passes
# it to the container at run time (`env_file`).
#
# Docker runs only the Cartoona web app. Supabase (or whatever replaces it) is
# an external service: these values point the container at it.
# ──────────────────────────────────────────────────────────────────────────────

# ── BUILD-TIME *and* RUNTIME ─────────────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`, so
# the browser gets whatever was present at build time, while server code reads
# them from the container environment at run time. Supply them BOTH ways, with
# the same values — see docs/DOCKER.md ("Environment variables").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── RUNTIME ONLY — never a build arg, never in an image layer ────────────────
# Supabase secret (service-role) key. Server-side only.
SUPABASE_SECRET_KEY=your-secret-key-here
# Project ref of the project above (the part before .supabase.co).
SUPABASE_PROJECT_REF=your-project-ref

# ── RUNTIME ONLY — rate limiting (V0.1.32) ───────────────────────────────────
# Secret used to hash client identifiers in rate-limit keys. Set any long
# random string; leave empty to accept the built-in default behaviour.
RATE_LIMIT_HASH_SECRET=
# Header to trust for the client IP. Only set this when a proxy you control
# sets it — behind nothing, leave it empty so the socket address is used.
RATE_LIMIT_TRUSTED_IP_HEADER=
# "true" disables enforcement. Leave empty for a prod-like container.
RATE_LIMIT_DISABLED=

# ── RUNTIME ONLY — logging ───────────────────────────────────────────────────
# debug | info | warn | error. Defaults to info.
LOG_LEVEL=

# ── Deliberately NOT set in a prod-like container ────────────────────────────
# These are development-only switches. The server also refuses them when
# NODE_ENV=production, which it is in this image. Keep them unset.
# CARTOONA_ENABLE_DEV_PAYMENT_SIMULATION=
# DEV_PARENT_AUTH_ENABLED=
# DEV_PARENT_AUTH_SECRET=
#
# Destructive/stateful test variables (CARTOONA_TEST_*,
# CARTOONA_ALLOW_DESTRUCTIVE_TESTS) belong in .env.local for local test runs
# ONLY. Never pass them to a container.
