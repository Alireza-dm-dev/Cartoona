# ──────────────────────────────────────────────────────────
# Cartoona — Local Environment Variables (Template)
# ──────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values
# from your Supabase project. Do NOT commit `.env.local`.
#
# See docs/SUPABASE_SETUP.md for step-by-step instructions.
# ──────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────

# Supabase Project URL
# Find it in Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key
# Find it in Supabase Dashboard > Project Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase secret (service-role) key
# Keep this secret. Never expose it to the browser.
# Used by trusted server/admin operations. The app reads SUPABASE_SECRET_KEY.
SUPABASE_SECRET_KEY=your-secret-key-here

# Project ref of the project above (the part before .supabase.co).
SUPABASE_PROJECT_REF=your-project-ref

# ── Stateful test target (DISPOSABLE project only) ────────────────────────
# Destructive / stateful specs (tests/e2e) never infer their target from the
# runtime block above. They require this explicit block, and the guard in
# tests/helpers/assert-safe-database-target.ts refuses to run unless:
#   * CARTOONA_ALLOW_DESTRUCTIVE_TESTS is "true"
#   * CARTOONA_TEST_SUPABASE_URL and CARTOONA_TEST_SUPABASE_PROJECT_REF are set
#   * every identifier above AND below names the SAME project
#   * that project is not production
# Point the runtime block at the same disposable project while you run them.
# Never put production values here. Keep each key defined ONCE in this file:
# a repeated Supabase key with a different value stops the test run.
CARTOONA_ALLOW_DESTRUCTIVE_TESTS=true
CARTOONA_TEST_SUPABASE_PROJECT_REF=your-disposable-project-ref
CARTOONA_TEST_SUPABASE_URL=https://your-disposable-project-ref.supabase.co
CARTOONA_TEST_SUPABASE_ANON_KEY=your-disposable-anon-key-here
CARTOONA_TEST_SUPABASE_SECRET_KEY=your-disposable-secret-key-here
# Optional: session-pooler connection string for the disposable database (psql).
CARTOONA_TEST_DATABASE_URL=

# ── Site ──────────────────────────────────────────────────

# Public site URL for auth redirects and OG meta tags
# Change to your production URL when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Optional) ───────────────────────────────────

# Plain PostgreSQL for the data-access layer (lib/db, V0.1.39), e.g. the local
# compose database as an app login role:
#   postgresql://cartoona_app_login:<password>@localhost:5433/cartoona
# Never a Supabase connection string: lib/db refuses Supabase hosts.
DATABASE_URL=

# ── Backend (server-to-server) ────────────────────────────
# GET /api/creation-pricing is served by the Fastify backend (V0.1.41); without
# this the route answers its public 503. Start the backend with
# `npm run backend:dev` (needs a restricted DATABASE_URL, see above), then:
# Server-side only. Never NEXT_PUBLIC_*.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# BACKEND_REQUEST_TIMEOUT_MS=3000
# Signs identity assertions for authenticated backend calls (V0.1.42). Must be
# the SAME value the backend uses. Server-side only. openssl rand -hex 32
CARTOONA_INTERNAL_AUTH_SECRET=

# ── Development Payment Simulation ───────────────────────
# Set to "true" to enable the dev-only simulated payment completion endpoint.
# Server-enforced: production always blocks regardless of this flag.
# Only effective when NODE_ENV is not "production".
CARTOONA_ENABLE_DEV_PAYMENT_SIMULATION=true

# ── Stripe (Future) ──────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
