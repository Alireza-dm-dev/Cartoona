# ──────────────────────────────────────────────────────────
# Cartoona — Local Environment Variables (Template)
# ──────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values
# from your Supabase project. Do NOT commit `.env.local`.
#
# See docs/SUPABASE_SETUP.md for step-by-step instructions.
# ──────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────

# Supabase Project URL
# Find it in Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key
# Find it in Supabase Dashboard > Project Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key
# Keep this secret. Never expose it to the browser.
# Only used later for trusted server/admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site ──────────────────────────────────────────────────

# Public site URL for auth redirects and OG meta tags
# Change to your production URL when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Optional) ───────────────────────────────────

# Direct PostgreSQL connection string for CLI migration tools
# such as psql, pg_dump, or supabase db push.
# Find it in Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ── Development Payment Simulation ───────────────────────
# Set to "true" to enable the dev-only simulated payment completion endpoint.
# Server-enforced: production always blocks regardless of this flag.
# Only effective when NODE_ENV is not "production".
CARTOONA_ENABLE_DEV_PAYMENT_SIMULATION=true

# ── Stripe (Future) ──────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
