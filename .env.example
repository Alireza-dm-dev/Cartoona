# ── Supabase ──────────────────────────────────────────────
# Get these from Supabase Dashboard > Project Settings > API
# See docs/SUPABASE_SETUP.md for full instructions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# ── Stateful test target (DISPOSABLE project only) ───────────────────────
# Separate from the runtime block above. See .env.local.example.
CARTOONA_ALLOW_DESTRUCTIVE_TESTS=
CARTOONA_TEST_SUPABASE_PROJECT_REF=
CARTOONA_TEST_SUPABASE_URL=
CARTOONA_TEST_SUPABASE_ANON_KEY=
CARTOONA_TEST_SUPABASE_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────
# Public site URL for auth redirects and OG meta tags.
NEXT_PUBLIC_SITE_URL=

# ── Database (Optional) ───────────────────────────────────
# Direct PostgreSQL connection string for CLI migration tools.
# Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=

# ── Backend (server-to-server) ────────────────────────────
# Where the Next.js SERVER reaches the Fastify backend. Never NEXT_PUBLIC_*:
# the browser must not learn it. Docker sets it itself (http://backend:4000).
# Next.js on your Mac against `npm run backend:dev`:
#   BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# BACKEND_REQUEST_TIMEOUT_MS=3000   # optional, 250-15000, one attempt per request
# Signs identity assertions for authenticated backend calls (V0.1.42). Must be
# the SAME value the backend uses. Server-side only. openssl rand -hex 32
CARTOONA_INTERNAL_AUTH_SECRET=
BACKEND_INTERNAL_URL=

# ── Browser -> Next CSRF guard (V0.1.48) ─────────────────
# The exact public origin(s) of this app, comma-separated (scheme://host[:port],
# no path). Authenticated JSON writes from any other Origin are refused.
# Server-only, read at runtime. Unset outside production: http://localhost:3000
# and http://127.0.0.1:3000. Unset in production: every guarded write is refused.
CARTOONA_APP_ORIGIN=

# ── Development Payment Simulation ───────────────────────
# Enables dev-only simulated payment completion (non-production only).
CARTOONA_ENABLE_DEV_PAYMENT_SIMULATION=

# ── Stripe (Future) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
