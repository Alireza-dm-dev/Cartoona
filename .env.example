# ── Supabase ──────────────────────────────────────────────
# Get these from Supabase Dashboard > Project Settings > API
# See docs/SUPABASE_SETUP.md for full instructions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────
# Public site URL for auth redirects and OG meta tags.
NEXT_PUBLIC_SITE_URL=

# ── Database (Optional) ───────────────────────────────────
# Direct PostgreSQL connection string for CLI migration tools.
# Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=

# ── Development Payment Simulation ───────────────────────
# Enables dev-only simulated payment completion (non-production only).
CARTOONA_ENABLE_DEV_PAYMENT_SIMULATION=

# ── Stripe (Future) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
